{
  "name": "hetun-app",
  "version": "0.0.0",
  "scripts": {
    "dev:h5": "uni --host 127.0.0.1 --port 5173",
    "dev:app": "uni -p app",
    "build:h5": "uni build",
    "build:app": "uni build -p app",
    "type-check": "vue-tsc --noEmit",
    "check": "npm run type-check && npm run build:h5 && npm run build:app",
    "serve:api": "node server/index.mjs"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-5020620260917001",
    "@dcloudio/uni-app-plus": "3.0.0-5020620260917001",
    "@dcloudio/uni-components": "3.0.0-5020620260917001",
    "@dcloudio/uni-h5": "3.0.0-5020620260917001",
    "qrcode": "1.5.4",
    "vue": "3.4.21",
    "vue-i18n": "9.14.5"
  },
  "devDependencies": {
    "@dcloudio/types": "3.4.31",
    "@dcloudio/uni-cli-shared": "3.0.0-5020620260917001",
    "@dcloudio/uni-stacktracey": "3.0.0-5020620260917001",
    "@dcloudio/vite-plugin-uni": "3.0.0-5020620260917001",
    "@vue/runtime-core": "3.4.21",
    "@vue/tsconfig": "0.1.3",
    "typescript": "4.9.5",
    "vite": "5.2.8",
    "vue-tsc": "1.8.27"
  },
  "private": true,
  "description": "河豚 uni-app 影视客户端与可视化主题工作台",
  "engines": {
    "node": ">=22.0.0 <23",
    "npm": ">=10 <11"
  },
  "packageManager": "npm@10.9.9"
}
